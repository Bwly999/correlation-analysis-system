# 存储驱动类型 (可选: local | server)
VITE_STORAGE_TYPE=local

# Node API 地址 (开发环境默认走 Vite 本地 /api 中间层)
VITE_API_BASE_URL=/api

# Node API JWT 鉴权（可选）
# - 后端配置 WORKFLOW_JWT_SECRET 后，会要求所有非 OPTIONS 的 Node API 请求携带 Authorization: Bearer <JWT>
# - JWT payload 默认使用 w3Account 作为用户 ID、cnName 作为用户名称
# - 完全本地模式不配置 WORKFLOW_JWT_SECRET 即可保持无鉴权使用
# - VITE_WORKFLOW_API_AUTH_TOKEN 仅适合本地调试；生产环境建议在 src/services/apiAuth.ts 对接内部系统 token
# WORKFLOW_JWT_SECRET=your_shared_secret
# VITE_WORKFLOW_API_AUTH_TOKEN=your_local_debug_jwt

# 机器相关的本地覆盖项请放到 .env.local，例如：
# WORKFLOW_STORAGE_BACKEND=mysql
# WORKFLOW_STORAGE_MYSQL_HOST=127.0.0.1
# WORKFLOW_STORAGE_MYSQL_PORT=3306
# WORKFLOW_STORAGE_MYSQL_USER=root
# WORKFLOW_STORAGE_MYSQL_PASSWORD=your_password
# WORKFLOW_STORAGE_MYSQL_DATABASE=correlation_analysis_system

# AI Workflow 配置 (用于 AI 编排功能)
# 请设置 OPENAI_API_KEY 环境变量
OPENAI_API_KEY=your_api_key_here
OPENAI_COMPAT_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
WORKFLOW_AI_DEFAULT_MODEL=glm-4.7

# Python 算法服务地址（供 Node 后端代理调用，按运行环境注入）
# PYTHON_ANALYSIS_API_BASE_URL=http://127.0.0.1:8000

# Notebook Agent 会话 JSONL 文件存放目录（相对于 cwd）
#   本地：<NOTEBOOK_SESSION_DIR>/<sessionId 或 SDK 生成的文件名>.jsonl
#   S3 ：s3://<NOTEBOOK_SESSION_S3_BUCKET>/notebook-agent/sessions/<filename>.jsonl
# NOTEBOOK_SESSION_DIR=workflow/sessions

# Notebook Agent 会话文件 S3/MinIO 远端归档（不设置则仅本地存储）
# NOTEBOOK_SESSION_S3_ENDPOINT=http://127.0.0.1:9000
# NOTEBOOK_SESSION_S3_BUCKET=notebook-agent-sessions
# NOTEBOOK_SESSION_S3_ACCESS_KEY=minioadmin
# NOTEBOOK_SESSION_S3_SECRET_KEY=minioadmin
# NOTEBOOK_SESSION_S3_REGION=us-east-1

# Notebook Agent workspace 文件快照（inputs/scripts/artifacts/reports）本地存放目录。
# 浏览器 OPFS 为主存，本目录为服务端降级兜底（换设备/清缓存时从 zip 快照恢复）。
#   本地：<NOTEBOOK_WORKSPACE_DIR>/<sessionId>.zip
#   S3 ：s3://<NOTEBOOK_SESSION_S3_BUCKET>/notebook-agent/workspace-snapshots/<sessionId>.zip
# S3 归档复用上面的 NOTEBOOK_SESSION_S3_*（同一 client，与 sessions/ 前缀隔离）。
# NOTEBOOK_WORKSPACE_DIR=workflow/workspace-snapshots

# Pi Agent 会话 JSONL 文件存放目录（相对于 cwd）
# PI_AGENT_SESSION_DIR=.workflow-debug/pi-agent-sessions

# 工作流执行历史 S3/MinIO 远端存储（需 WORKFLOW_STORAGE_BACKEND=mysql）
# WORKFLOW_HISTORY_S3_ENDPOINT=http://127.0.0.1:9000
# WORKFLOW_HISTORY_S3_BUCKET=workflow-history
# WORKFLOW_HISTORY_S3_ACCESS_KEY=minioadmin
# WORKFLOW_HISTORY_S3_SECRET_KEY=minioadmin
# WORKFLOW_HISTORY_S3_REGION=us-east-1
