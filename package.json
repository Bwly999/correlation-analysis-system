{
  "name": "correlation-analysis-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "run-p type-check \"build-only {@}\" build:server --",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "type-check:server": "tsc -p tsconfig.server.json --noEmit",
    "db:mysql:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:mysql:migrate": "tsx scripts/mysql-storage-migrate.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=es2022 --format=esm --outfile=dist-server/server/index.js --sourcemap --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start:server": "node dist-server/server/index.js",
    "format": "prettier --write --experimental-cli src/",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint src/ --fix",
    "pack:release": "node scripts/pack-release.mjs",
    "eval:workflow-mcp": "npx tsx scripts/workflow-mcp-evaluation/run.ts",
    "eval:agentic-analysis": "npx tsx scripts/agentic-analysis-evaluation/run.ts",
    "smoke:deepseek-agentic": "npx tsx scripts/deepseek-agentic-smoke/run.ts",
    "smoke:opencode-generic": "npx tsx scripts/opencode-generic-smoke/run.ts",
    "smoke:agentic-kernel": "npx tsx scripts/agentic-kernel-smoke/run.ts",
    "smoke:agentic-kernel:visualize": "npx tsx scripts/agentic-kernel-smoke/visualize-last-run.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.37",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "^1.4.3",
    "@primevue/core": "^4.5.5",
    "@primevue/themes": "^4.5.4",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/node-toolbar": "^1.1.1",
    "@vueuse/core": "^14.2.1",
    "ag-grid-community": "^35.2.1",
    "ag-grid-vue3": "^35.2.1",
    "ai": "^6.0.134",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "echarts": "^6.0.0",
    "element-plus": "^2.13.6",
    "jose": "^6.2.2",
    "lowdb": "^7.0.1",
    "lucide-vue-next": "^0.577.0",
    "mysql2": "^3.22.2",
    "papaparse": "^5.5.3",
    "pinia": "^3.0.4",
    "primevue": "^4.5.4",
    "radix-vue": "^1.9.17",
    "shadcn-vue": "^2.4.3",
    "tailwind-merge": "^3.5.0",
    "typebox": "^1.1.38",
    "vue": "^3.5.29",
    "vue-draggable-plus": "0.6.1",
    "vue-echarts": "^8.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@guolao/vue-monaco-editor": "^1.6.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/archiver": "^7.0.0",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^24.11.0",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "4.0.18",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "archiver": "^7.0.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "monaco-editor": "^0.55.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.8.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "unplugin-auto-import": "^21.0.0",
    "vite": "^7.3.1",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
