{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["server/**/*.ts", "src/server/**/*.ts", "src/ai/types.ts"],
  "exclude": ["src/server/__tests__/**/*", "dist-server/**/*"],
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist-server",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": false,
    "sourceMap": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true
  }
}
